# Copy this file to .env and enter your own provider credentials.
PORT=8767

# Image: OpenAI-style multipart POST /images/edits, returning data[0].b64_json.
# Include /v1 in the base URL when your provider requires it.
CODEX_IMAGE_BASE_URL=
CODEX_IMAGE_API_KEY=
CODEX_IMAGE_MODEL=gpt-image-2

# Video: Grok-compatible async generation + polling + media download.
GROK_VIDEO_BASE_URL=
GROK_VIDEO_API_KEY=
GROK_VIDEO_MODEL=grok-imagine-video-1.5
